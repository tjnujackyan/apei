page {
  /* TDesign Override Variables */
  --td-brand-color: #10A37F;
  --td-brand-color-active: #0D8A6A;
  --td-brand-color-light: #E7F7F2;
  --td-brand-color-focus: #10A37F;
  --td-brand-color-disabled: #A0D9C9;
  
  /* Unified Theme Variables */
  --theme-primary: #10A37F;
  --theme-bg: #FFFFFF;
  --theme-text-primary: #1D1D1F;
  --theme-text-secondary: #86868B;
  --theme-font-serif: 'Noto Serif SC', Georgia, serif;
  --theme-shadow-card: 0 4px 16px rgba(0, 0, 0, 0.04);
  --theme-radius-card: 20px;
  --theme-radius-button: 50rpx;

  /* Legacy iOS Variables */
  --ios-bg: #F2F2F7;
  --ios-card-bg: #FFFFFF;
  --ios-blue: #007AFF;
  --ios-gray-text: #8E8E93;
  --ios-radius: 20px;
  --ios-radius-lg: 32px;
  --ios-shadow: 0 8px 24px rgba(0, 0, 0, 0.04);
  --ios-font-serif: "Times New Roman", "Songti SC", serif;
  
  background-color: var(--ios-bg);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Segoe UI, Arial, Roboto, "PingFang SC", "miui", "Hiragino Sans GB", "Microsoft Yahei", sans-serif;
  box-sizing: border-box;
  
  /* 禁止页面左右拖拽/橡皮筋效果 */
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;
}

/* Hide Scrollbar Globally */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
  display: none;
}

/* 全局禁止左右滑动 */
.container {
  padding: 16px;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;
}

/* 通用滚动区域样式 */
scroll-view {
  -webkit-overflow-scrolling: touch;
}

scroll-view::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
}

/* Inset Grouped Style Card */
.ios-card {
  background: var(--ios-card-bg);
  border-radius: var(--ios-radius);
  padding: 20px;
  margin-bottom: 16px;
  box-shadow: var(--ios-shadow);
}

/* Typography */
.ios-title {
  font-size: 34px;
  font-weight: 700;
  color: #000000;
  letter-spacing: -0.02em; /* tracking-tight */
  margin-bottom: 16px;
  padding-left: 4px;
}

.ios-subtitle {
  font-size: 20px;
  font-weight: 600;
  color: #000000;
  margin-bottom: 12px;
}

.ios-text-secondary {
  color: var(--ios-gray-text);
  font-size: 14px;
}

/* Micro-interaction Button */
.ios-btn {
  background: var(--ios-blue);
  color: white;
  border-radius: 999px; /* Capsule */
  padding: 14px 24px;
  font-weight: 600;
  text-align: center;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.ios-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* Backdrop Blur Utility */
.glass-effect {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}
