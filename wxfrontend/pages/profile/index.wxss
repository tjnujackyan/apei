page {
  background: var(--theme-bg);
  -webkit-tap-highlight-color: transparent;
  overflow-x: hidden;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120px;
  position: relative;
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;
}

/* Background Decorations (Unified with Home) */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  background-color: #F0F9F6;
  z-index: 0;
  pointer-events: none;
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  top: -100rpx;
  left: -200rpx;
}

.circle-2 {
  width: 500rpx;
  height: 500rpx;
  bottom: 200rpx;
  right: -200rpx;
}

.content-wrapper {
  position: relative;
  z-index: 1;
}

.header-section {
  padding: 0 20px 24px;
}

.large-title {
  font-size: 28px;
  font-weight: 700;
  color: var(--theme-text-primary);
  font-family: var(--theme-font-serif);
  margin-bottom: 16px;
  padding-left: 4px;
}

/* User Card */
.user-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20px;
  border-radius: 20px;
  margin-bottom: 24px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(0,0,0,0.02);
}

.avatar-placeholder {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: #E5E5EA;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16px;
  font-size: 24px;
  font-weight: 600;
  color: #8E8E93;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 20px;
  font-weight: 600;
  color: #000000;
  margin-bottom: 4px;
}

.user-desc {
  font-size: 14px;
  color: #8E8E93;
  margin-bottom: 2px;
}

.user-id {
  font-size: 12px;
  color: #C7C7CC;
}

.arrow {
  font-size: 20px;
  color: #C7C7CC;
  font-family: system-ui;
  margin-left: 8px;
}

/* Settings Group */
.settings-group {
  background: #FFFFFF;
  border-radius: 16px;
  margin: 0 20px 16px;
  overflow: hidden;
  box-shadow: 0 2px 8px rgba(0,0,0,0.02);
}

.list-item {
  display: flex;
  align-items: center;
  padding-left: 16px;
  background: #FFFFFF;
}

.list-item:active {
  background: #F9F9F9;
}

.item-icon {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
}

/* Icon Colors */
.red-bg { background: #FF3B30; }
.blue-bg { background: #007AFF; }
.orange-bg { background: #FF9500; }
.gray-bg { background: #8E8E93; }
.green-bg { background: #34C759; }

.item-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 16px 14px 0;
  border-bottom: 0.5px solid rgba(0, 0, 0, 0.1);
  min-height: 24px;
}

.item-content.no-border {
  border-bottom: none;
}

.item-content.centered {
  justify-content: center;
  padding-right: 16px; /* Balance left padding of container */
}

.item-label {
  font-size: 16px;
  color: #000000;
}

.item-right {
  display: flex;
  align-items: center;
}

.item-value.warning {
  font-size: 14px;
  color: #FF3B30;
  margin-right: 4px;
}

.logout-text {
  color: #FF3B30;
  font-weight: 600;
}

.version-info {
  text-align: center;
  font-size: 13px;
  color: #8E8E93;
  margin-top: 24px;
}

/* Skeleton Loading */
.skeleton .skeleton-bg {
  background: #E5E5EA;
  animation: pulse 1.5s infinite;
}

.skeleton-text {
  height: 16px;
  border-radius: 4px;
}

@keyframes pulse {
  0% { opacity: 1; }
  50% { opacity: 0.5; }
  100% { opacity: 1; }
}
