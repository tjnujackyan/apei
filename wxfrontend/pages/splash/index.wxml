<view class="splash-container">
  <view class="content {{showLogin ? 'move-up' : ''}}">
    <view class="logo">
      <text class="logo-text">陪</text>
    </view>
    <view class="app-name">阿 陪</view>
    <view class="slogan-main">你的 AI学霸室友</view>
    <view class="slogan-sub">24小时陪读 · 读心 · 进步</view>
  </view>

  <!-- 登录区域（从底部浮现） -->
  <view class="login-area {{showLogin ? 'show' : ''}}">
    <button class="btn-wechat" bindtap="onWeChatLogin" loading="{{isLoading}}">
      <text class="wechat-icon"></text> 微信一键登录
    </button>
    
    <view class="agreement">
      <text class="text">登录即代表同意</text>
      <text class="link" bindtap="showAgreement" data-type="user">《用户协议》</text>
      <text class="text">和</text>
      <text class="link" bindtap="showAgreement" data-type="privacy">《隐私政策》</text>
    </view>
  </view>

  <view class="footer" wx:if="{{!showLogin}}">
   
  </view>
  
  <!-- 背景装饰圆 -->
  <view class="bg-circle circle-1"></view>
  <view class="bg-circle circle-2"></view>
</view>
