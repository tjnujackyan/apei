page {
  height: 100%;
  background-color: #ffffff;
  overflow-x: hidden;
}

.splash-container {
  width: 100%;
  max-width: 100vw;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow-x: hidden;
}

.content {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
  margin-bottom: 100rpx;
  transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.content.move-up {
  transform: translateY(-160rpx) scale(0.9);
}

.logo {
  width: 160rpx;
  height: 160rpx;
  background-color: #1AAD84;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 10rpx rgba(26, 173, 132, 0.3);
  transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.content.move-up .logo {
  width: 140rpx;
  height: 140rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(26, 173, 132, 0.4);
}

.logo-text {
  color: #ffffff;
  font-size: 80rpx;
  font-family: serif;
  font-weight: bold;
  transition: font-size 0.8s ease;
}

.content.move-up .logo-text {
  font-size: 70rpx;
}

.app-name {
  font-size: 64rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  font-family: serif;
  letter-spacing: 10rpx;
  transition: all 0.8s ease;
}

.content.move-up .app-name {
  margin-bottom: 20rpx;
  opacity: 0.9;
}

.slogan-main {
  font-size: 32rpx;
  color: #666666;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
  transition: all 0.6s ease;
}

.content.move-up .slogan-main {
  opacity: 0.8;
  transform: scale(0.95);
}

.slogan-sub {
  font-size: 24rpx;
  color: #999999;
  letter-spacing: 2rpx;
  transition: all 0.6s ease;
}

.content.move-up .slogan-sub {
  opacity: 0;
  transform: translateY(20rpx);
}

/* 登录区域 */
.login-area {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 80rpx 50rpx 120rpx;
  background: #FFFFFF;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  transform: translateY(110%);
  transition: transform 0.8s cubic-bezier(0.19, 1, 0.22, 1);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.05);
}

.login-area.show {
  transform: translateY(0);
}

.btn-wechat {
  width: 100% !important;
  height: 100rpx;
  background-color: #1AAD84;
  color: #FFFFFF;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 20rpx rgba(26, 173, 132, 0.2);
}

.wechat-icon {
  font-size: 36rpx;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.text {
  color: #999999;
}

.link {
  color: #1AAD84;
}

.footer {
  position: absolute;
  bottom: 100rpx;
  z-index: 10;
}

.dots {
  display: flex;
  gap: 16rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #1AAD84;
  border-radius: 50%;
}

/* 背景装饰 */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  background-color: #F0F9F6;
  z-index: 1;
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  top: -100rpx;
  left: -200rpx;
}

.circle-2 {
  width: 500rpx;
  height: 500rpx;
  bottom: 200rpx;
  right: -200rpx;
}
