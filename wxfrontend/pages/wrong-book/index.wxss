page {
  background: var(--theme-bg);
  -webkit-tap-highlight-color: transparent;
  overflow-x: hidden;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120px;
  position: relative;
  z-index: 1;
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;
}

/* Background Decorations (Unified with Home) */
.bg-circle {
  position: absolute;
  border-radius: 50%;
  background-color: #F0F9F6;
  z-index: 0;
  pointer-events: none;
}

.circle-1 {
  width: 600rpx;
  height: 600rpx;
  top: -100rpx;
  left: -200rpx;
}

.circle-2 {
  width: 500rpx;
  height: 500rpx;
  bottom: 200rpx;
  right: -200rpx;
}

.header-section {
  padding: 0 20px 24px;
  position: relative;
  z-index: 1;
}

.large-title {
  font-size: 28px;
  font-weight: 700;
  color: var(--theme-text-primary);
  font-family: var(--theme-font-serif);
  margin-bottom: 4px;
  letter-spacing: normal;
}

.subtitle {
  font-size: 14px;
  color: var(--theme-text-secondary);
  margin-top: 0;
}

/* Section */
.section {
  padding: 0 20px;
  margin-bottom: 24px;
  position: relative;
  z-index: 1;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px 0;
  color: #8E8E93;
  gap: 12px;
  margin-bottom: 24px;
  position: relative;
  z-index: 1;
}

.loading-container {
  position: relative;
  z-index: 1;
}

.subject-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 20px;
  border-radius: 20px;
  margin-bottom: 16px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
  border: 1px solid rgba(0,0,0,0.02);
}

.subject-card:active {
  transform: scale(0.98);
}

.subject-icon {
  font-size: 24px;
  width: 48px;
  height: 48px;
  background: #F5F7F9;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16px;
}

.subject-info {
  flex: 1;
}

.subject-name {
  font-size: 16px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 4px;
}

.subject-meta {
  font-size: 12px;
  color: #86868B;
}

.wrong-count-badge {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-right: 12px;
}

.wrong-count-badge .count {
  font-size: 18px;
  font-weight: 700;
  color: #FF3B30;
  line-height: 1;
}

.wrong-count-badge .label {
  font-size: 10px;
  color: #FF3B30;
  opacity: 0.8;
  margin-top: 2px;
}

.arrow {
  font-size: 20px;
  color: #C5C5C5;
  font-weight: 300;
}