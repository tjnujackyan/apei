<view class="page-container" style="padding-top: {{paddingTop}}px;">
  <!-- Background Decorations -->
  <view class="bg-circle circle-1"></view>
  <view class="bg-circle circle-2"></view>

  <view class="header-section">
    <view class="large-title">错题本</view>
    <view class="subtitle">温故而知新</view>
  </view>

  <block wx:if="{{loading}}">
    <view class="loading-container">
      <t-loading theme="circular" size="40rpx" text="加载中..." />
    </view>
  </block>
  
  <block wx:elif="{{questionSets.length === 0}}">
    <view class="empty-state">
      <t-icon name="check-circle" size="48px" color="#34C759" />
      <text>暂无错题，继续保持！</text>
    </view>
  </block>

  <block wx:else>
    <view class="section">
      <block wx:for="{{questionSets}}" wx:key="id">
        <view class="subject-card" bindtap="onGoToDetail" data-id="{{item.id}}" data-title="{{item.title}}">
          <view class="subject-icon">
            <t-icon wx:if="{{item.source === 'ai-generated'}}" name="cooperation" size="22px" />
            <t-icon wx:else name="books" size="22px" />
          </view>
          <view class="subject-info">
            <view class="subject-name">{{item.title}}</view>
            <view class="subject-meta">{{item.subject}}</view>
          </view>
          <view class="wrong-count-badge">
            <text class="count">{{item.wrongCount}}</text>
            <text class="label">错题</text>
          </view>
          <view class="arrow">›</view>
        </view>
      </block>
    </view>
  </block>
</view>