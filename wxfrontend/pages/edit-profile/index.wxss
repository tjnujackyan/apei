/* 编辑资料页 - 统一风格 */

/* Variables */
page {
  --theme-primary: #10A37F;
  --theme-primary-light: rgba(16, 163, 127, 0.1);
  --bg-primary: #F2F2F7;
  --text-primary: #1D1D1F;
  --text-secondary: #8E8E93;
  background: var(--bg-primary);
  overflow-x: hidden;
}

/* Background Decorations */
.bg-circle {
  position: fixed;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(16, 163, 127, 0.08) 0%, rgba(16, 163, 127, 0.02) 100%);
  z-index: 0;
  pointer-events: none;
}

.circle-1 {
  width: 300px;
  height: 300px;
  top: -100px;
  right: -80px;
}

.circle-2 {
  width: 200px;
  height: 200px;
  bottom: 200px;
  left: -60px;
}

/* Page Container */
.page-container {
  min-height: 100vh;
  padding: 20px;
  padding-bottom: 120px;
  box-sizing: border-box;
}

.content-wrapper {
  position: relative;
  z-index: 1;
}

/* Header */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.back-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.back-btn:active {
  background: #F5F5F5;
}

.page-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
}

.page-title.serif {
  font-family: Georgia, 'Times New Roman', serif;
}

.header-placeholder {
  width: 40px;
}

/* Loading State */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
  color: var(--text-secondary);
  gap: 12px;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Form Content */
.form-content {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Section Card */
.section-card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  border: 1px solid rgba(0, 0, 0, 0.02);
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16px;
}

.section-desc {
  font-size: 13px;
  color: var(--text-secondary);
  margin-top: -8px;
  margin-bottom: 16px;
}

/* Form Item */
.form-item {
  margin-bottom: 16px;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

/* Input Wrapper - 背景容器 */
.input-wrapper {
  background: #F5F5F7;
  border-radius: 12px;
  padding: 0 16px;
  height: 48px;
  display: flex;
  align-items: center;
}

.form-input {
  flex: 1;
  width: 100%;
  height: 100%;
  background: transparent;
  border: none;
  font-size: 16px;
  color: var(--text-primary);
}

.form-input::placeholder {
  color: #C7C7CC;
}

/* Gender Options */
.gender-options {
  display: flex;
  gap: 12px;
}

.gender-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px 12px;
  background: #F5F5F7;
  border-radius: 14px;
  border: 2px solid transparent;
  transition: all 0.2s ease;
}

.gender-option.active {
  background: var(--theme-primary-light);
  border-color: var(--theme-primary);
}

.gender-option:active {
  transform: scale(0.96);
}

.gender-icon {
  font-size: 28px;
  margin-bottom: 6px;
}

.gender-label {
  font-size: 14px;
  color: var(--text-secondary);
}

.gender-option.active .gender-label {
  color: var(--theme-primary);
  font-weight: 500;
}

/* Chip Group */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-bottom: 16px;
}

.chip {
  padding: 8px 14px;
  background: #F5F5F7;
  border-radius: 20px;
  font-size: 13px;
  color: var(--text-secondary);
  transition: all 0.2s ease;
}

.chip.active {
  background: var(--theme-primary-light);
  color: var(--theme-primary);
  font-weight: 500;
}

.chip:active {
  transform: scale(0.96);
}

/* Persona List */
.persona-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.persona-card {
  display: flex;
  align-items: center;
  padding: 16px;
  background: #F5F5F7;
  border-radius: 16px;
  border: 2px solid transparent;
  transition: all 0.2s ease;
}

.persona-card.selected {
  background: var(--theme-primary-light);
  border-color: var(--theme-primary);
}

.persona-card:active {
  transform: scale(0.98);
}

.persona-avatar {
  width: 48px;
  height: 48px;
  background: #FFFFFF;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-right: 14px;
  flex-shrink: 0;
}

.persona-avatar.active {
  background: var(--theme-primary);
}

.persona-info {
  flex: 1;
}

.persona-name {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.persona-desc {
  font-size: 12px;
  color: var(--text-secondary);
}

.check-circle {
  width: 24px;
  height: 24px;
  border: 2px solid #D1D1D6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  color: transparent;
  flex-shrink: 0;
}

.check-circle.checked {
  background: var(--theme-primary);
  border-color: var(--theme-primary);
  color: #FFFFFF;
}

/* Bottom Action */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px 24px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1px solid rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.btn-save {
  width: 100%;
  background: var(--theme-primary);
  color: #FFFFFF;
  border: none;
  border-radius: 14px;
  padding: 16px 32px;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s ease;
}

.btn-save:active {
  background: #0D8A6A;
  transform: scale(0.98);
}

.btn-save.disabled {
  background: #C7C7CC;
}
