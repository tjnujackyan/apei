/* 聊天 DIY 页面样式 */
@import '../../styles/bubbles/index.wxss';

page {
  --theme-primary: #10A37F;
  --bg-primary: #F2F2F7;
  --text-primary: #1D1D1F;
  --text-secondary: #8E8E93;
  background: var(--bg-primary);
  overflow-x: hidden;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120px;
  position: relative;
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;
}

/* Background Decorations */
.bg-circle {
  position: fixed;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(16, 163, 127, 0.08) 0%, rgba(16, 163, 127, 0.02) 100%);
  z-index: 0;
  pointer-events: none;
}

.circle-1 { width: 300px; height: 300px; top: -100px; right: -80px; }
.circle-2 { width: 200px; height: 200px; bottom: 100px; left: -60px; }

/* Header */
.header-section {
  position: relative;
  padding: 16px 20px 24px;
  z-index: 1;
}

.back-btn {
  position: absolute;
  left: 16px;
  top: 16px;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 50%;
}

.large-title {
  font-size: 28px;
  font-weight: 700;
  color: var(--text-primary);
  text-align: center;
  margin-bottom: 4px;
}

.subtitle {
  font-size: 14px;
  color: var(--text-secondary);
  text-align: center;
}

/* Preview Card */
.preview-card {
  margin: 0 20px 24px;
  padding: 20px 16px;
  border-radius: 20px;
  background: #F5F5F7;
  min-height: 140px;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

.preview-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 12px;
}

.preview-message.ai {
  flex-direction: row;
}

.preview-message.user {
  flex-direction: row-reverse;
}

.preview-avatar {
  width: 36px;
  height: 36px;
  border-radius: 6px;
  margin-right: 10px;
  flex-shrink: 0;
}

.preview-bubble {
  padding: 10px 14px;
  max-width: 70%;
  font-size: 14px;
  color: #000;
  /* 默认样式，会被 bubble-style-X 覆盖 */
  background: #FFFFFF;
  border: 1px solid rgba(0,0,0,0.05);
  border-radius: 6px;
  position: relative;
}

/* 气泡背景图片 */
.preview-bubble .bubble-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  pointer-events: none;
}

/* 气泡文字内容 */
.preview-bubble .bubble-text-content {
  position: relative;
  z-index: 1;
}

/* 手绘气泡样式 */
.preview-bubble.bubble-style-1,
.preview-bubble.bubble-style-2 {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  overflow: visible;
}

.preview-bubble.user-bubble {
  background: #95EC69 !important;
  border: none !important;
  border-radius: 18rpx !important;
}

/* Settings Wrapper */
.settings-wrapper {
  position: relative;
  z-index: 1;
}

.section {
  margin-bottom: 24px;
  padding: 0 20px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 12px;
}

/* Upload Row */
.upload-row {
  display: flex;
  align-items: center;
  gap: 16px;
  background: #FFFFFF;
  padding: 16px;
  border-radius: 16px;
}

.upload-item {
  width: 80px;
  height: 80px;
  border-radius: 16px;
  overflow: hidden;
  flex-shrink: 0;
  border: 2px dashed #E5E5E5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-item.bg-upload {
  width: 100px;
  height: 80px;
}

.upload-preview {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  color: #999;
  font-size: 12px;
}

.upload-tip {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.upload-tip text {
  font-size: 14px;
  color: var(--text-primary);
}

.upload-tip .tip-sub {
  font-size: 12px;
  color: var(--text-secondary);
}

.reset-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  padding: 8px;
  color: #999;
  font-size: 11px;
}

.reset-btn:active {
  opacity: 0.7;
}

/* Bubble Options */
.bubble-scroll {
  width: 100%;
  white-space: nowrap;
}

.bubble-options {
  display: inline-flex;
  gap: 16px;
  padding: 8px 20px 8px 0;
}

.bubble-option {
  flex-shrink: 0;
  width: 120px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  transition: all 0.2s;
  outline: 3px solid transparent;
  outline-offset: 4px;
}

.bubble-option.selected {
  outline-color: var(--theme-primary);
}

.bubble-text {
  font-size: 14px;
  color: #333;
}

/* Font Options */
.font-options {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.font-option {
  background: #FFFFFF;
  padding: 16px 8px;
  border-radius: 16px;
  text-align: center;
  border: 3px solid transparent;
  transition: all 0.2s;
}

.font-option.selected {
  border-color: var(--theme-primary);
}

.font-preview {
  font-size: 24px;
  display: block;
  margin-bottom: 4px;
  color: var(--text-primary);
}

.font-name {
  font-size: 12px;
  color: var(--text-secondary);
}

/* Save Button */
.save-btn-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16px 20px;
  padding-bottom: calc(16px + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #F2F2F7 80%, transparent);
  z-index: 100;
}

.save-btn {
  background: var(--theme-primary);
  color: #FFFFFF;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  padding: 14px 0;
  border-radius: 50px;
  transition: all 0.2s;
}

.save-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.save-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}
