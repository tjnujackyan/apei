<view class="screen">
  <view class="gradient"></view>

  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content" style="height: {{navBarHeight}}px;">
      <view class="nav-back" bindtap="onBack">
        <t-icon name="chevron-left" size="24px" color="#333" />
      </view>
      <view class="nav-title">智能复习</view>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <view class="container" style="padding-top: {{statusBarHeight + navBarHeight + 16}}px;">
    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <t-loading theme="circular" size="40rpx" text="加载中..." />
    </view>

    <!-- 主内容 -->
    <block wx:else>
      <!-- 状态概览卡片 -->
      <view class="status-card">
        <view class="status-header">
          <view class="status-icon"><t-icon name="root-list" size="22px" color="#10A37F" /></view>
          <view class="status-title">复习状态</view>
        </view>
        
        <view class="status-grid">
          <view class="status-item">
            <view class="status-value {{status.hasWeakness ? 'highlight' : ''}}">{{status.weaknessCount || 0}}</view>
            <view class="status-label">薄弱知识点</view>
          </view>
          <view class="status-divider"></view>
          <view class="status-item">
            <view class="status-value {{status.hasNewKnowledge ? 'highlight' : ''}}">{{status.newKnowledgeCount || 0}}</view>
            <view class="status-label">新学知识</view>
          </view>
          <view class="status-divider"></view>
          <view class="status-item">
            <view class="status-value primary">{{status.suggestedReviewCount || 0}}</view>
            <view class="status-label">建议复习</view>
          </view>
        </view>
      </view>

      <!-- 薄弱点列表 -->
      <view class="weakness-section" wx:if="{{status.topWeaknesses && status.topWeaknesses.length > 0}}">
        <view class="section-title"><t-icon name="location" size="16px" /> 薄弱知识点</view>
        <view class="weakness-list">
          <view class="weakness-item" wx:for="{{status.topWeaknesses}}" wx:key="knowledgePointId">
            <view class="weakness-name">{{item.knowledgePointName}}</view>
            <view class="weakness-stats">
              <text class="error-rate">错误率 {{item.errorRate * 100}}%</text>
              <text class="error-count">{{item.errorCount}}次错误</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 生成设置 -->
      <view class="settings-section" wx:if="{{hasContent}}">
        <view class="section-title"><t-icon name="setting" size="16px" /> 生成设置</view>
        
        <view class="setting-card">
          <view class="setting-item">
            <view class="setting-label">题目数量</view>
            <view class="setting-control count-control">
              <input 
                type="number" 
                class="count-input"
                value="{{totalCount}}" 
                bindinput="onCountInput"
                bindblur="onCountBlur"
                placeholder="10-30"
              />
              <text class="count-unit">题</text>
            </view>
          </view>
          
          <view class="setting-item">
            <view class="setting-label">
              <text>生成变式题</text>
              <text class="setting-hint">使用AI改写题目，避免死记硬背</text>
            </view>
            <switch checked="{{enableTransform}}" color="#10A37F" bindchange="onTransformChange" />
          </view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="action-section">
        <block wx:if="{{hasContent}}">
          <button class="primary-btn {{generating ? 'disabled' : ''}}" bindtap="onGenerate" disabled="{{generating}}">
            <t-icon wx:if="{{generating}}" name="loading" size="20px" color="#fff" />
            <text>{{generating ? '生成中...' : '开始智能复习'}}</text>
          </button>
          <view class="action-hint">将根据你的薄弱点和新学知识生成个性化题库</view>
        </block>
        <block wx:else>
          <view class="empty-state">
            <view class="empty-icon"><t-icon name="check-circle" size="48px" color="#34C759" /></view>
            <view class="empty-title">暂无需要复习的内容</view>
            <view class="empty-desc">继续学习新知识，系统会自动追踪你的学习状态</view>
          </view>
        </block>
      </view>
    </block>
  </view>
</view>
