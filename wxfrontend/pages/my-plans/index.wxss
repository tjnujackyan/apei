/* 学习计划页 - 统一风格 */

page {
  --theme-primary: #10A37F;
  --theme-primary-light: rgba(16, 163, 127, 0.1);
  --bg-primary: #F2F2F7;
  --text-primary: #1D1D1F;
  --text-secondary: #8E8E93;
  background: var(--bg-primary);
  overflow-x: hidden;
}

/* Background Decorations */
.bg-circle {
  position: fixed;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(16, 163, 127, 0.08) 0%, rgba(16, 163, 127, 0.02) 100%);
  z-index: 0;
  pointer-events: none;
}

.circle-1 { width: 300px; height: 300px; top: -100px; right: -80px; }
.circle-2 { width: 200px; height: 200px; bottom: 200px; left: -60px; }

/* Page Container */
.page-container {
  min-height: 100vh;
  padding: 20px;
  padding-bottom: 40px;
  box-sizing: border-box;
}

.content-wrapper {
  position: relative;
  z-index: 1;
}

/* Header */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.back-btn, .add-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.back-btn:active, .add-btn:active {
  background: #F5F5F5;
}

.page-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
}

.page-title.serif {
  font-family: Georgia, 'Times New Roman', serif;
}

/* Loading State */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
  color: var(--text-secondary);
  gap: 12px;
}

.spin {
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Section */
.section {
  margin-bottom: 24px;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
}

.task-count {
  font-size: 13px;
  color: var(--theme-primary);
  background: var(--theme-primary-light);
  padding: 4px 10px;
  border-radius: 12px;
}

/* Empty Card */
.empty-card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 40px 20px;
  text-align: center;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-text {
  font-size: 16px;
  color: var(--text-primary);
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 13px;
  color: var(--text-secondary);
}

/* Task List */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.task-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.task-card.completed {
  opacity: 0.6;
}

.task-check {
  width: 24px;
  height: 24px;
  border: 2px solid #D1D1D6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
  font-size: 14px;
  color: transparent;
}

.task-check.checked {
  background: var(--theme-primary);
  border-color: var(--theme-primary);
  color: #FFFFFF;
}

.task-info {
  flex: 1;
}

.task-title {
  font-size: 15px;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.task-card.completed .task-title {
  text-decoration: line-through;
}

.task-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
}

.task-time {
  color: var(--text-secondary);
}

.task-status {
  padding: 2px 8px;
  border-radius: 8px;
}

.task-status.status-pending {
  background: #F5F5F7;
  color: var(--text-secondary);
}

.task-status.status-in_progress {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.task-status.status-completed {
  background: var(--theme-primary-light);
  color: var(--theme-primary);
}

/* Plan List */
.plan-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.plan-card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.plan-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.plan-name {
  font-size: 16px;
  font-weight: 600;
  color: var(--text-primary);
}

.plan-subject {
  font-size: 12px;
  color: var(--theme-primary);
  background: var(--theme-primary-light);
  padding: 4px 10px;
  border-radius: 8px;
}

.plan-progress {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.progress-bar {
  flex: 1;
  height: 8px;
  background: #F5F5F7;
  border-radius: 4px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--theme-primary) 0%, #34C759 100%);
  border-radius: 4px;
  transition: width 0.3s ease;
}

.progress-text {
  font-size: 13px;
  font-weight: 600;
  color: var(--theme-primary);
  min-width: 40px;
  text-align: right;
}

.plan-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: var(--text-secondary);
}

/* Stats Card */
.stats-card {
  display: flex;
  background: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 4px;
}

.stat-value.accent {
  color: var(--theme-primary);
}

.stat-label {
  font-size: 12px;
  color: var(--text-secondary);
}
