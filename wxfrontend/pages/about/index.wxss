/* 关于页 - 统一风格 */

page {
  --theme-primary: #10A37F;
  --bg-primary: #F2F2F7;
  --text-primary: #1D1D1F;
  --text-secondary: #8E8E93;
  background: var(--bg-primary);
  overflow-x: hidden;
}

/* Background Decorations */
.bg-circle {
  position: fixed;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(16, 163, 127, 0.08) 0%, rgba(16, 163, 127, 0.02) 100%);
  z-index: 0;
  pointer-events: none;
}

.circle-1 { width: 300px; height: 300px; top: -100px; right: -80px; }
.circle-2 { width: 200px; height: 200px; bottom: 200px; left: -60px; }

/* Page Container */
.page-container {
  min-height: 100vh;
  padding: 20px;
  padding-bottom: 40px;
  box-sizing: border-box;
}

.content-wrapper {
  position: relative;
  z-index: 1;
}

/* Header */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.back-btn {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.back-btn:active {
  background: #F5F5F5;
}

.page-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--text-primary);
}

.page-title.serif {
  font-family: Georgia, 'Times New Roman', serif;
}

.header-placeholder {
  width: 40px;
}

/* App Info Card */
.app-info-card {
  background: linear-gradient(135deg, var(--theme-primary) 0%, #34C759 100%);
  border-radius: 20px;
  padding: 40px 20px;
  text-align: center;
  margin-bottom: 20px;
  box-shadow: 0 8px 24px rgba(16, 163, 127, 0.2);
}

.app-logo {
  width: 80px;
  height: 80px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
}

.logo-emoji {
  font-size: 40px;
}

.app-name {
  font-size: 24px;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.app-slogan {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 16px;
}

.app-version {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
  padding: 4px 12px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  display: inline-block;
}

/* Features Card */
.features-card {
  background: #FFFFFF;
  border-radius: 16px;
  padding: 8px;
  margin-bottom: 20px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 16px 12px;
}

.feature-icon {
  width: 48px;
  height: 48px;
  background: #F5F5F7;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-right: 14px;
  flex-shrink: 0;
}

.feature-info {
  flex: 1;
}

.feature-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 2px;
}

.feature-desc {
  font-size: 12px;
  color: var(--text-secondary);
}

/* Links Card */
.links-card {
  background: #FFFFFF;
  border-radius: 16px;
  overflow: hidden;
  margin-bottom: 24px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
}

.link-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px;
  border-bottom: 1px solid #F5F5F7;
}

.link-item.no-border {
  border-bottom: none;
}

.link-item:active {
  background: #F9F9F9;
}

.link-label {
  font-size: 16px;
  color: var(--text-primary);
}

.arrow {
  font-size: 20px;
  color: #C7C7CC;
  font-family: system-ui;
}

/* Footer */
.footer {
  text-align: center;
  padding: 20px 0;
}

.copyright {
  font-size: 13px;
  color: var(--text-secondary);
  margin-bottom: 4px;
}

.icp {
  font-size: 12px;
  color: #C7C7CC;
}
