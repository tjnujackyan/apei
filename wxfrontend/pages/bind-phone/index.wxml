<view class="bind-phone-page" style="padding-top: {{paddingTop}}px;">
  


  <!-- 内容区域 -->
  <view class="content">
    <!-- 标题 -->
    <view class="title-section">
      <view class="icon-wrapper">
        <text class="main-icon"><t-icon name="mobile" size="32px" /></text>
      </view>
      <view class="title serif">绑定手机号</view>
      <view class="subtitle">验证后可以更安全地使用账号<br/>（此步骤可跳过）</view>
    </view>

    <!-- 表单 -->
    <view class="form-section">
      <!-- 手机号输入 -->
      <view class="input-group">
        <view class="input-label">手机号</view>
        <input 
          class="input-field" 
          type="number" 
          maxlength="11"
          placeholder="请输入手机号" 
          value="{{phoneNumber}}"
          bindinput="onPhoneInput"
        />
      </view>

      <!-- 验证码输入 -->
      <view class="input-group">
        <view class="input-label">验证码</view>
        <view class="code-input-wrapper">
          <input 
            class="input-field code-input" 
            type="number" 
            maxlength="6"
            placeholder="请输入验证码" 
            value="{{smsCode}}"
            bindinput="onCodeInput"
          />
          <button 
            class="send-code-btn {{canSendCode ? '' : 'disabled'}}" 
            bindtap="sendCode"
            disabled="{{!canSendCode}}"
          >
            {{countdown > 0 ? countdown + 's' : '发送验证码'}}
          </button>
        </view>
      </view>

      <!-- 提示信息 -->
      <view class="hint-box">
        <text class="hint-icon"><t-icon name="lightbulb" size="16px" color="#FF9500" /></text>
        <text class="hint-text">绑定手机号后，可以在其他设备快速登录</text>
      </view>
    </view>

    <!-- 按钮组 -->
    <view class="button-group">
      <button 
        class="btn-primary {{canSubmit ? '' : 'disabled'}}" 
        bindtap="submit"
        disabled="{{!canSubmit}}"
      >
        确认绑定
      </button>
      
      <button class="btn-text" bindtap="skipBinding">
        暂不绑定，继续使用
      </button>
    </view>
  </view>
</view>
