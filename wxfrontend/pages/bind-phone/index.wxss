/* 绑定手机号页面 - ChatGPT风格 */

page {
  height: 100vh;
  overflow-x: hidden;
}

.bind-phone-page {
  height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 100vw;
}


/* ==================== 内容区域 ==================== */

.content {
  flex: 1;
  overflow-y: auto;
  padding: 20px 32px 60px; /* 增加左右内边距 */
  -webkit-overflow-scrolling: touch;
}

/* ==================== 标题区域 ==================== */

.title-section {
  text-align: center;
  margin-bottom: 48px;
}

.icon-wrapper {
  width: 80px;
  height: 80px;
  background: rgba(16, 163, 127, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
}

.main-icon {
  font-size: 40px;
}

.title {
  font-size: 28px;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12px;
}

.serif {
  font-family: 'Noto Serif SC', Georgia, serif;
}

.subtitle {
  font-size: 14px;
  color: #86868B;
  line-height: 1.6;
}

/* ==================== 表单区域 ==================== */

.form-section {
  margin-bottom: 40px;
}

.input-group {
  margin-bottom: 24px;
}

.input-label {
  font-size: 13px;
  color: #86868B;
  margin-bottom: 10px;
}

.input-field {
  width: 100%;
  height: 54px; /* 固定高度 */
  background: #F5F5F7;
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  padding: 0 20px; /* 移除垂直padding，使用height控制垂直居中 */
  font-size: 15px;
  color: #1D1D1F;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.input-field:focus {
  border-color: #10A37F;
  background: #FFFFFF;
  box-shadow: 0 0 0 3px rgba(16, 163, 127, 0.1);
}

.input-field::placeholder {
  color: #AEAEB2;
}

/* ==================== 验证码输入 ==================== */

.code-input-wrapper {
  display: flex;
  gap: 12px;
  align-items: center;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  flex-shrink: 0;
  width: 110px; /* 固定宽度 */
  height: 54px; /* 固定高度与输入框一致 */
  padding: 0; /* 移除padding，使用flex居中 */
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F7; /* 默认浅灰色背景 */
  color: #10A37F; /* 绿色文字 */
  border: 1px solid #E5E5E5;
  border-radius: 12px;
  font-size: 14px;
  font-weight: 500;
  transition: all 0.2s ease;
}

.send-code-btn::after {
  border: none;
}

.send-code-btn:active {
  background: #E5E5E5;
  transform: scale(0.98);
}

.send-code-btn.disabled {
  background: #F5F5F7;
  color: #AEAEB2;
  opacity: 0.8;
}

/* ==================== 提示框 ==================== */

.hint-box {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 14px 16px;
  background: rgba(16, 163, 127, 0.06);
  border-left: 3px solid #10A37F;
  border-radius: 10px;
  margin-top: 24px;
}

.hint-icon {
  font-size: 16px;
  flex-shrink: 0;
}

.hint-text {
  font-size: 13px;
  color: #0D8A6A;
  line-height: 1.5;
}

/* ==================== 按钮组 ==================== */

.button-group {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.btn-primary {
  width: 100%;
  background: #10A37F;
  color: #FFFFFF;
  border: none;
  border-radius: 12px;
  padding: 16px 32px;
  font-size: 16px;
  font-weight: 600;
  text-align: center;
  transition: all 0.2s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  background: #0D8A6A;
  transform: scale(0.98);
}

.btn-primary.disabled {
  background: #E5E5E5;
  color: #AEAEB2;
}

.btn-text {
  width: 100%;
  background: transparent;
  color: #86868B;
  border: none;
  padding: 14px 32px;
  font-size: 15px;
  font-weight: 500;
  text-align: center;
  transition: all 0.2s ease;
}

.btn-text::after {
  border: none;
}

.btn-text:active {
  color: #10A37F;
}
