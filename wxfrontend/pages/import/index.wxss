page {
  background: #F7F7F7; /* Light gray background */
  --theme-primary: #10A37F;
  --theme-text-primary: #1D1D1F;
  --theme-text-secondary: #86868B;
  overflow-x: hidden;
}

.screen {
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  width: 100%;
  max-width: 100vw;
}

.container {
  padding: 20px;
}

/* Tabs */
.tabs-wrapper {
  margin-bottom: 24px;
  background: #EFEFF4;
  border-radius: 8px;
  padding: 4px;
  display: flex;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  font-size: 14px;
  color: var(--theme-text-secondary);
  border-radius: 6px;
  transition: all 0.2s;
}

.tab-item.active {
  background: #FFFFFF;
  color: var(--theme-primary);
  font-weight: 600;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

/* Header / Title Input */
.header-input-area {
  margin-bottom: 24px;
}

.main-title-input {
  font-size: 24px;
  font-weight: 600;
  color: var(--theme-text-primary);
  background: transparent;
  padding: 0;
  --td-input-bg-color: transparent;
  --td-input-vertical-padding: 0;
}

/* Common Card Style */
.card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 20px;
  margin-bottom: 20px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.card-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--theme-text-primary);
}

.card-content {
  /* content area */
}

/* Subject Input */
.subject-input {
  font-size: 16px;
  color: var(--theme-text-primary);
  --td-input-bg-color: transparent;
  --td-input-vertical-padding: 0;
  padding: 0;
}

/* Configuration Form */
.form-item {
  padding: 8px 0;
}

.label-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
}

.label {
  font-size: 14px;
  color: var(--theme-text-primary);
  font-weight: 500;
}

.divider {
  height: 1px;
  background: #F5F5F5;
  margin: 16px 0;
}

/* Custom Checkbox Group */
.checkbox-group {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 12px;
}

.check-circle {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  border: 2px solid #E5E5EA; /* Unchecked border */
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.checkbox-item.active .check-circle {
  background-color: var(--theme-primary);
  border-color: var(--theme-primary);
}

.checkbox-item text {
  font-size: 16px;
  color: var(--theme-text-primary);
}

/* Upload Card */
.section-label {
  font-size: 16px;
  font-weight: 600;
  color: var(--theme-text-primary);
  margin-bottom: 12px;
  margin-left: 4px;
}

.upload-card {
  min-height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed rgba(0, 0, 0, 0.05); /* Optional dashed border */
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.upload-icon-circle {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: rgba(16, 163, 127, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-hint {
  font-size: 14px;
  color: var(--theme-text-secondary);
}

/* File Preview */
.file-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  width: 100%;
}

.file-icon {
  width: 48px;
  height: 48px;
  background: #10A37F;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8px;
}

.file-icon text {
  color: white;
  font-size: 12px;
  font-weight: bold;
}

.file-details {
  text-align: center;
}

.file-name-text {
  display: block;
  font-size: 14px;
  color: var(--theme-text-primary);
  margin-bottom: 4px;
  max-width: 200px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.file-status {
  font-size: 12px;
  color: var(--theme-text-secondary);
}

.remove-icon {
  position: absolute;
  top: -10px;
  right: -10px;
  padding: 10px; /* larger touch area */
}

/* Footer Button */
.footer-action {
  margin-top: 40px;
  padding-bottom: 40px;
}

.submit-btn {
  background: #10A37F;
  color: white;
  border-radius: 30px;
  height: 50px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(16, 163, 127, 0.3);
  border: none;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

/* Hint Card Styles */
.beta-tag {
  font-size: 12px;
  color: #FF9C19;
  background: rgba(255, 156, 25, 0.1);
  padding: 2px 8px;
  border-radius: 4px;
}

.hint-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.hint-image {
  width: 100%;
  border-radius: 8px;
  background-color: #F5F5F5;
  display: block; /* Removes bottom space */
}

.hint-text {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 13px;
  color: var(--theme-text-secondary);
  line-height: 1.5;
}

/* Progress Overlay */
.progress-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  animation: fadeIn 0.3s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.progress-modal {
  background: white;
  border-radius: 24px;
  padding: 32px 24px;
  margin: 0 40px;
  width: calc(100% - 80px);
  max-width: 400px;
  box-shadow: 0 12px 48px rgba(0, 0, 0, 0.2);
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(20px);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.progress-header {
  text-align: center;
  margin-bottom: 24px;
}

.progress-title {
  display: block;
  font-size: 20px;
  font-weight: 600;
  color: var(--theme-text-primary);
  margin-bottom: 8px;
}

.progress-stage {
  display: block;
  font-size: 14px;
  color: var(--theme-primary);
  font-weight: 500;
}

/* 步骤指示器 */
.progress-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
  padding: 0 20px;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  flex: 0 0 auto;
}

.step-circle {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.step-item.active .step-circle {
  background: linear-gradient(135deg, #10A37F 0%, #15D1A4 100%);
  box-shadow: 0 4px 12px rgba(16, 163, 127, 0.3);
  animation: pulse 2s infinite;
}

.step-item.completed .step-circle {
  background: #10A37F;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.step-icon {
  font-size: 24px;
}

.step-item.active .step-icon,
.step-item.completed .step-icon {
  filter: brightness(0) invert(1);
}

.step-label {
  font-size: 12px;
  color: #999;
  font-weight: 500;
}

.step-item.active .step-label {
  color: var(--theme-primary);
  font-weight: 600;
}

.step-line {
  flex: 1;
  height: 2px;
  background: #E5E5EA;
  margin: 0 12px;
  margin-bottom: 30px;
  transition: all 0.3s ease;
}

.step-line.active {
  background: linear-gradient(90deg, #10A37F 0%, #15D1A4 100%);
}

.progress-message {
  display: block;
  text-align: center;
  font-size: 14px;
  color: var(--theme-text-secondary);
  margin-bottom: 16px;
  min-height: 20px;
}

.progress-tip {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 12px;
  background: #F7F7F7;
  border-radius: 8px;
}

.progress-tip text {
  font-size: 12px;
  color: #999;
  line-height: 1.4;
}
