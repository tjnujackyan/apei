page {
  background: #F7F7F7;
  --theme-primary: #10A37F;
  --theme-text-primary: #1D1D1F;
  --theme-text-secondary: #86868B;
}

.page-container {
  min-height: 100vh;
  box-sizing: border-box;
}

.container {
  padding: 20px;
}

/* Card Common */
.card {
  background: #FFFFFF;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.02);
  margin-bottom: 24px;
}

/* Info Card */
.header-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20px;
}

.set-title {
  font-size: 22px;
  font-weight: 700;
  color: var(--theme-text-primary);
  margin-bottom: 6px;
  line-height: 1.3;
}

.set-subtitle {
  font-size: 14px;
  color: var(--theme-text-secondary);
}

.subject-icon-lg {
  font-size: 40px;
}

.divider {
  height: 1px;
  background: #F5F5F5;
  margin-bottom: 20px;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 24px;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 24px;
  font-weight: 700;
  color: var(--theme-text-primary);
  margin-bottom: 4px;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
}

.stat-label {
  font-size: 12px;
  color: var(--theme-text-secondary);
}

/* Action Buttons */
.action-row {
  display: flex;
  gap: 16px;
}

.action-btn {
  flex: 1;
  height: 48px;
  border-radius: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 16px;
  font-weight: 600;
  border: none;
  padding: 0;
  line-height: 1;
}

.action-btn::after {
  border: none;
}

.action-btn.primary {
  background: var(--theme-primary);
  color: white;
  box-shadow: 0 4px 12px rgba(16, 163, 127, 0.3);
}

.action-btn.secondary {
  background: #F2F2F7;
  color: var(--theme-text-primary);
}

.action-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* Section Title */
.section-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--theme-text-primary);
  margin-bottom: 12px;
  padding-left: 4px;
}

/* Progress Card */
.progress-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.progress-date {
  font-size: 14px;
  color: var(--theme-text-primary);
  font-weight: 500;
}

.progress-status {
  font-size: 12px;
  padding: 4px 10px;
  border-radius: 12px;
  font-weight: 500;
}

.progress-status.active {
  background: rgba(16, 163, 127, 0.1);
  color: var(--theme-primary);
}

.progress-status.completed {
  background: #F2F2F7;
  color: var(--theme-text-secondary);
}

.progress-text {
  font-size: 13px;
  color: var(--theme-text-secondary);
}

/* History List */
.history-list {
  display: flex;
  flex-direction: column;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 20px;
  margin-bottom: 12px;
}

.history-date {
  font-size: 14px;
  font-weight: 600;
  color: var(--theme-text-primary);
  margin-bottom: 4px;
}

.history-meta {
  font-size: 12px;
  color: var(--theme-text-secondary);
}

.accuracy-badge {
  font-size: 14px;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: 8px;
}

.accuracy-badge.high {
  background: rgba(16, 163, 127, 0.1);
  color: #10A37F;
}

.accuracy-badge.mid {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.accuracy-badge.low {
  background: rgba(255, 59, 48, 0.1);
  color: #FF3B30;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px 0;
  color: var(--theme-text-secondary);
}

.empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
  opacity: 0.5;
}
