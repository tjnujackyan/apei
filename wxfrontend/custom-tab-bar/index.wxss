@font-face {
  font-family: 't';
  src: url('https://tdesign.gtimg.com/icon/0.3.2/fonts/t.ttf') format('truetype');
  font-weight: 400;
  font-style: normal;
}

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 56px; /* Increased height from 48px to accommodate larger spacing */
  background: #FFFFFF !important;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 10000;
  box-shadow: 0 -1px 4px rgba(0, 0, 0, 0.05);
}

.tab-bar-border {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 0.5px;
  background-color: rgba(0, 0, 0, 0.1);
  transform: scaleY(0.5);
}

.tab-bar-item {
  flex: 1;
  text-align: center;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
}

.icon-box {
  width: 24px;
  height: 24px;
  margin-bottom: 6px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.tab-icon {
  width: 24px;
  height: 24px;
}

.tab-text {
  font-size: 10px;
  font-weight: 500;
  line-height: 1;
}