# ============================================
# OhMyGPT GPT-5.2 Configuration Template
# ============================================
# 
# OhMyGPT 提供最先进的 GPT-5.2 模型
# - 400K 上下文窗口
# - 128K 最大输出
# - 多种推理模式
#
# 使用说明：
# 1. 复制此文件为 .env
# 2. 填写你的 API Key
# 3. 重启服务
# ============================================

# ============================================
# LLM Provider 配置
# ============================================
LLM_PROVIDER=ohmygpt
LLM_BASE_URL=https://api.ohmygpt.com/v1
LLM_API_KEY=your-ohmygpt-api-key-here

# ============================================
# 模型选择
# ============================================
# GPT-5.2 模型选项：
# - gpt-5.2       : 通用模型，平衡速度和质量
# - gpt-5.2-pro   : 专业模型，适合科研级任务
LLM_MODEL=gpt-5.2

# ============================================
# 推理模式 (Reasoning Effort)
# ============================================
# 推理深度级别：
# - none    : 无推理（最快）
# - minimal : 最小推理
# - low     : 轻度推理
# - medium  : 中等推理（推荐，默认）⭐
# - high    : 深度推理（复杂问题）
# - xhigh   : 极限推理（科研级，最慢）
LLM_REASONING_EFFORT=medium

# ============================================
# 超时设置
# ============================================
# 由于 GPT-5.2 支持长上下文，超时设置建议更长
# 推荐：180000ms (3分钟) 用于复杂任务
LLM_TIMEOUT_MS=180000

# ============================================
# 数据库配置 (保持不变)
# ============================================
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/dev.db

# ============================================
# JWT 配置 (保持不变)
# ============================================
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# ============================================
# 服务端口 (保持不变)
# ============================================
PORT=3000

# ============================================
# TTS/ASR 配置 (可选，保持不变)
# ============================================
TTS_BASE_URL=wss://openspeech.bytedance.com/api/v1/tts/ws_binary
TTS_ACCESS_TOKEN=your-doubao-tts-token
TTS_APP_ID=your-app-id
TTS_RESOURCE_ID=volc.service_type.10029
TTS_VOICE=zh_female_shuangkuaisisi_moon_bigtts
TTS_SPEED_RATIO=0.85
TTS_VOLUME_RATIO=1.1
TTS_PITCH_RATIO=1.0
TTS_EMOTION=gentle

ASR_APP_ID=your-app-id
ASR_ACCESS_KEY=your-access-key
ASR_RESOURCE_ID=volc.bigasr.auc

# ============================================
# 推荐配置组合
# ============================================
#
# 快速响应（适合简单问答）:
#   LLM_REASONING_EFFORT=minimal
#   LLM_TIMEOUT_MS=60000
#
# 平衡模式（推荐，日常使用）:
#   LLM_REASONING_EFFORT=medium
#   LLM_TIMEOUT_MS=180000
#
# 深度分析（适合复杂推理）:
#   LLM_REASONING_EFFORT=high
#   LLM_TIMEOUT_MS=300000
#
# 专家级（科研、代码审查）:
#   LLM_MODEL=gpt-5.2-pro
#   LLM_REASONING_EFFORT=xhigh
#   LLM_TIMEOUT_MS=600000
#
# ============================================
