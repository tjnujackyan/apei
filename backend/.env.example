# Application
PORT=3000
APP_NAME=apei-backend

# Database
# Use sqlite for local dev if desired
# DB_TYPE=sqlite
# SQLITE_PATH=dev.db

# If using Postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=apei

# JWT
JWT_SECRET=dev-secret-key-change-in-prod
JWT_EXPIRES_IN=2h

# LLM (Doubao / Qwen)
LLM_PROVIDER=doubao
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# TTS (VolcEngine / Doubao)
# WebSocket Endpoint: wss://openspeech.bytedance.com/api/v3/tts/bidirection
TTS_BASE_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
TTS_ACCESS_TOKEN=your_access_token
TTS_APP_ID=your_app_id
TTS_RESOURCE_ID=volc.service_type.10029
TTS_VOICE=BV001_streaming

# ASR (VolcEngine / Doubao 大模型录音文件识别)
# 文档: https://www.volcengine.com/docs/6561/xxx
# 如果ASR和TTS使用相同的火山引擎账号，可以复用TTS的凭证
ASR_APP_ID=your_app_id
ASR_ACCESS_KEY=your_access_key
# 资源ID: volc.bigasr.auc (1.0模型) 或 volc.seedasr.auc (2.0模型)
ASR_RESOURCE_ID=volc.bigasr.auc

# 对象存储（二选一）
# 使用阿里云 OSS（推荐，本地与生产均可用）
STORAGE_TYPE=oss
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 可选：自定义域名时填写，如 https://cdn.example.com
# OSS_ENDPOINT=

# 使用微信云 COS（仅微信云托管环境可用）
# STORAGE_TYPE=wxcloud
# WXCLOUD_BUCKET=your-bucket
# WXCLOUD_REGION=ap-shanghai
